pipeline{
    agent{}
    environment {
        INSTANCE_ID = 'i-0b188089b9df7ebac'
        KEY_NAME = 'uskey'
    }
    stages{
        stage("checkout-code-stage"){
            steps{
                git branch: 'main', poll: false, url: 'https://github.com/Suryansh2188/e-commerce-application.git'
            }
            post{
                always{
                    echo "========always========"
                }
                success{
                    echo "========checkout-code-stage executed successfully========"
                }
                failure{
                    echo "========checkout-code-stage execution failed========"
                }
            }
        }

        stage("change-directory-stage"){
            steps{
                dir('edublitz-e-commerce-application-shopitry/shopitry-infrastructure-terrafrom') {
                    sh 'cp terraform.tfvars.example terraform.tfvars'
                }
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++change-directory-stage executed successfully++++===="
                }
                failure{
                    echo "====++++change-directory-stage execution failed++++===="
                }
        
            }
        }

        stage("terraform-init-stage"){
            steps{
                dir('edublitz-e-commerce-application-shopitry/shopitry-infrastructure-terrafrom') {
                    sh 'terraform init'
                }
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++terraform-init-stage executed successfully++++===="
                }
                failure{
                    echo "====++++terraform-init-stage execution failed++++===="
                }
        
            }
        }

        stage("terraform-validate-stage"){
            steps{
                dir('edublitz-e-commerce-application-shopitry/shopitry-infrastructure-terrafrom') {
                    sh 'terraform validate'
                }
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++terraform-validate-stage executed successfully++++===="
                }
                failure{
                    echo "====++++terraform-validate-stage execution failed++++===="
                }
        
            }
        }

        stage("terraform-plan-stage"){
            steps{
                dir('edublitz-e-commerce-application-shopitry/shopitry-infrastructure-terrafrom') {
                    sh '''
                    terraform plan \
                    -var="instance_id=${INSTANCE_ID}" \
                    -var="key_name=${KEY_NAME}"
                '''
                }
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++terraform-plan-stage executed successfully++++===="
                }
                failure{
                    echo "====++++terraform-plan-stage execution failed++++===="
                }
        
            }
        }

        stage("plan-approval-stage"){
            steps{
                input cancel: 'Cancel', message: 'Approve infrastructure changes?', ok: 'Approve'
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++plan-approval-stage executed successfully++++===="
                }
                failure{
                    echo "====++++plan-approval-stage execution failed++++===="
                }
        
            }
        }

        stage("terraform-apply-stage"){
            steps{
                dir('edublitz-e-commerce-application-shopitry/shopitry-infrastructure-terrafrom') {
                    sh '''
                    terraform apply --auto-approve \
                    -var="instance_id=${INSTANCE_ID}" \
                    -var="key_name=${KEY_NAME}"
                '''
                }
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++terraform-apply-stage executed successfully++++===="
                }
                failure{
                    echo "====++++terraform-apply-stage execution failed++++===="
                }
        
            }
        }
    }
    post{
        always{
            echo "========always========"
        }
        success{
            echo "========infrastructure pipeline executed successfully ========"
        }
        failure{
            echo "========infrastructure pipeline execution failed========"
        }
    }
}