project_name = "shopitry"

aws_region = "us-east-1"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.3.0/24",
  "10.0.4.0/24"
]


# ---------------------------------------------------------
# Control plan EC2 Id
# ---------------------------------------------------------

instance_id = "YOUR_INSTANCE_ID"


# ---------------------------------------------------------
# EC2
# ---------------------------------------------------------

ami_id = "ami-0b6d9d3d33ba97d99"

instance_type = "m7i-flex.large"

key_name = "YOUR_KEY_NAME"

acm_certificate_arn = "YOUR_ACM_CERTIFICATE_ARN"


# ---------------------------------------------------------
# EC2 MICROSERVICES
# ---------------------------------------------------------

services = {

  gateway = {

    name = "gateway-service"

    folder = "gateway-service"

    port = 5000

    private_ip = "10.0.1.10"

    public = true
  }


  catalog = {

    name = "catalog-service"

    folder = "catalog-service"

    port = 5001

    private_ip = "10.0.3.11"

    public = false
  }


  cart = {

    name = "cart-service"

    folder = "cart-service"

    port = 5002

    private_ip = "10.0.3.12"

    public = false
  }


  order = {

    name = "order-service"

    folder = "order-service"

    port = 5003

    private_ip = "10.0.3.13"

    public = false
  }
}